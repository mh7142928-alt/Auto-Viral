# Google Gemini API Key (From https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (From https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# Video Settings
VIDEO_ORIENTATION=portrait # portrait (9:16)
TARGET_DURATION=30 # seconds (e.g. 25-45)
VOICE_NAME=ar-SA-ShakirNeural # ar-SA-ShakirNeural, ar-SA-HamedNeural, ar-EG-SalmaNeural
VOICE_RATE=+10% # slightly faster for engaging shorts

# Publishing API Keys (to be filled when setting up auto-publish)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
